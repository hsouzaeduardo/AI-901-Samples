# ---------------------------------------------------------------------------
# AI-901 - Exemplos práticos
# Copie este arquivo para ".env" (na raiz do repositório) e preencha os valores.
# NUNCA faça commit do arquivo .env - ele já está no .gitignore.
#
# Onde encontrar os valores: Portal do Foundry (https://ai.azure.com) >
#   seu projeto > Visão geral (Overview) > "Chave de API" e "Pontos de extremidade".
# Um único recurso do Foundry atende a todos os módulos.
# ---------------------------------------------------------------------------

# Chave do recurso do Foundry (usada por OpenAI, Linguagem, Fala e Content Understanding)
AZURE_FOUNDRY_KEY=

# Ponto de extremidade compatível com a API da OpenAI (termina em /openai/v1/)
# Ex.: https://meu-recurso.openai.azure.com/openai/v1/
AZURE_OPENAI_ENDPOINT=

# Ponto de extremidade do PROJETO do Foundry (usado pelo SDK azure-ai-projects / agentes)
# Ex.: https://meu-recurso.services.ai.azure.com/api/projects/meu-projeto
PROJECT_ENDPOINT=

# Ponto de extremidade dos serviços de IA (Linguagem do Azure e Fala do Azure)
# Ex.: https://meu-recurso.cognitiveservices.azure.com/
AZURE_AI_SERVICES_ENDPOINT=

# Ponto de extremidade do Content Understanding e do Voice Live
# Ex.: https://meu-recurso.services.ai.azure.com/
AZURE_SERVICES_AI_ENDPOINT=

# Nomes das IMPLANTAÇÕES (deployment names) que você criou no projeto
MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
IMAGE_DEPLOYMENT_NAME=gpt-image-1
VIDEO_DEPLOYMENT_NAME=sora-2

# Content Understanding (módulo 06): nomes das SUAS implantações para cada modelo
# exigido pelos analisadores (usados por 04_content_understanding_sdk.py --configurar)
CU_GPT41_DEPLOYMENT=gpt-4.1
CU_GPT41_MINI_DEPLOYMENT=gpt-4.1-mini
CU_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Voice Live (módulo 04)
VOICELIVE_MODEL=gpt-realtime
VOICE_NAME=pt-BR-FranciscaNeural

# Servidor MCP da Linguagem do Azure (módulo 03, exemplo 09)
# Copie a URL no portal do Foundry: Ferramentas (Tools) > Azure Language > MCP
LANGUAGE_MCP_URL=
# (Opcional) ID da conexão do projeto que guarda a credencial do servidor MCP
LANGUAGE_MCP_CONNECTION_ID=
